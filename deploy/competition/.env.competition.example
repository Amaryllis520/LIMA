# 参赛配置示例：资源值为建议值，非性能保证；不自动加载。
# 安全起点：无模型凭据、agent/分诊/调查 off、受信构建 false。
# 共享变量只写一次；先读 README 的入口区别与安全使用步骤。

# 全局 app / Compose 插值
# 单位：路径；命令：python -m lima；联动：填写只读导入树；pilot 必须另传 --repository-import-root。
LIMA_REPOSITORY_IMPORT_ROOT=./REPLACE_WITH_IMPORT_ROOT
# 单位：路径；命令：docker compose --profile cxx up；联动：仅 Compose 插值；容器 IMPORT_ROOT 固定为 /repositories。
LIMA_REPOSITORY_IMPORT_PATH=./REPLACE_WITH_IMPORT_PATH
# 单位：枚举；命令：python -m lima；联动：只接受本地导入；pilot 不读此项。
LIMA_REPOSITORY_SCAN_SOURCES=local-import
# 单位：文件数；命令：python -m lima / python -m cxx_analyzer.server / python scripts/run_openharmony_validation.py；联动：app、Sidecar、pilot 同值；CLI --max-files 优先。
LIMA_REPOSITORY_SCAN_MAX_FILES=50000
# 单位：字节；命令：python -m lima / python -m cxx_analyzer.server / python scripts/run_openharmony_validation.py；联动：三入口同值；CLI --max-file-bytes 优先。
LIMA_REPOSITORY_SCAN_MAX_FILE_BYTES=4194304
# 单位：字节；命令：python -m lima / python -m cxx_analyzer.server / python scripts/run_openharmony_validation.py；联动：三入口同值；CLI --max-total-bytes 优先。
LIMA_REPOSITORY_SCAN_MAX_TOTAL_BYTES=2147483648
# 单位：路径；命令：python -m lima；联动：留空沿用默认；自填 <CACHE_ROOT> 并配套磁盘配额；Compose 默认命名卷。
LIMA_REPOSITORY_CACHE_ROOT=
# 单位：字节；命令：python -m lima；联动：建议 10GiB 起；仅启用 GitHub 物化时使用。
LIMA_REPOSITORY_CACHE_QUOTA_BYTES=10737418240
# 单位：字节；命令：python -m lima；联动：保持至少 512MiB；与缓存卷容量联动。
LIMA_REPOSITORY_CACHE_MIN_FREE_BYTES=536870912
# 单位：枚举；命令：python -m lima；联动：启用 app agent required 前需改为 auto/required。
LIMA_CXX_MEMORY_MODE=off
# 单位：URL；命令：python -m lima / python scripts/run_openharmony_validation.py；联动：Compose 内部地址；宿主 pilot 用 --cxx-analyzer-url <SIDECAR_URL>。
LIMA_CXX_ANALYZER_URL=http://cxx-analyzer:8090
# 单位：秒；命令：python -m lima；联动：pilot 不读；pilot 另传 --timeout；与 Sidecar 时限协调。
LIMA_CXX_ANALYSIS_TIMEOUT_SECONDS=900
# 单位：字节；命令：python -m lima；联动：pilot 不读且固定 8388608；不是 Sidecar AST 预算。
LIMA_CXX_MAX_RESPONSE_BYTES=16777216
# 单位：枚举；命令：python -m lima；联动：无凭据保持 off；pilot 不读且不受此开关保护。
LIMA_CXX_AGENT_MODE=off
# 单位：模型名；命令：python -m lima / python scripts/run_openharmony_validation.py；联动：留空回退；显式启用前填 <MODEL_ID> 或 LIMA_LLM_MODEL。
LIMA_CXX_AGENT_MODEL=
# 单位：调用次数；命令：python -m lima；联动：仅 app；pilot budget_factory 固定 160。
LIMA_CXX_AGENT_MAX_CALLS=40
# 单位：字节；命令：python -m lima；联动：仅 app；pilot budget_factory 固定 16777216。
LIMA_CXX_AGENT_MAX_OUTPUT_BYTES=1048576
# 单位：枚举；命令：python -m lima；联动：保持 off；启用时须与模型凭据及预算联动。
LIMA_REPOSITORY_SCAN_LLM_MODE=off
# 单位：枚举；命令：python -m lima；联动：保持 off；与语义分诊、agent 分开控制。
LIMA_REPOSITORY_INVESTIGATION_MODE=off
# 单位：枚举；命令：python -m lima / python scripts/run_openharmony_validation.py；联动：保持 local 且通用地址/密钥/模型全空；pilot 此值不是禁用门禁。
LIMA_LLM_PROVIDER=local
# 单位：URL；命令：python -m lima / python scripts/run_openharmony_validation.py；联动：留空；授权调用时填 <PROVIDER_BASE_URL>，同时填密钥和模型。
LIMA_LLM_BASE_URL=
# 单位：字符串（无单位）；命令：python -m lima / python scripts/run_openharmony_validation.py；联动：保持空；调用前在进程环境私下填写，勿提交。
LIMA_LLM_API_KEY=
# 单位：模型名；命令：python -m lima / python scripts/run_openharmony_validation.py；联动：留空；授权调用时填 <MODEL_ID> 并配套地址与密钥。
LIMA_LLM_MODEL=

# Sidecar
# 单位：布尔；命令：python -m cxx_analyzer.server；联动：保持 false；不等于受信构建执行授权。
LIMA_CXX_AUTO_CMAKE=false
# 单位：布尔；命令：python -m cxx_analyzer.server；联动：保持 false；Compose 不透传，开启需先满足 §3 全部探针。
LIMA_CXX_TRUSTED_BUILD_CONTEXT_GENERATION=false
# 单位：MiB；命令：python -m cxx_analyzer.server；联动：与容器限额和独立沙箱数协调。
LIMA_CXX_MAX_MEMORY_MB=8192
# 单位：进程数；命令：python -m cxx_analyzer.server；联动：与容器限额及并行度协调。
LIMA_CXX_MAX_PROCESSES=512
# 单位：字节；命令：python -m cxx_analyzer.server；联动：与单 TU 规模及内存预算协调。
LIMA_CXX_MAX_AST_JSON_BYTES=134217728
# 单位：秒；命令：python -m cxx_analyzer.server；联动：Compose 不透传；直接注入 Sidecar 进程；总时限不得小于步骤时限。
LIMA_CXX_STEP_TIMEOUT_SECONDS=600
# 单位：秒；命令：python -m cxx_analyzer.server；联动：Compose 不透传；直接注入 Sidecar 进程；客户端等待需另行协调。
LIMA_CXX_TOTAL_TIMEOUT_SECONDS=1800

# pilot CLI 专用
# 单位：JSON 对象（无单位）；命令：python scripts/run_openharmony_validation.py；联动：仅 pilot；按 provider 要求填写，例 thinking disabled；app 不读取。
LIMA_CXX_AGENT_REQUEST_PARAMS_JSON={}
